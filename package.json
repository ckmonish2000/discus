{
  "name": "discus",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "api": "bun --env-file=../../.env.local --filter=api run start:dev",
    "db:up": "docker compose up -d db redis",
    "db:generate": "bun run --filter=drizzle generate",
    "db:migrate": "bun run --filter=drizzle migrate",
    "test": "REDIS_HOST=localhost REDIS_PORT=6377 DATABASE_URL=postgresql://postgres:postgres@localhost:5433/discus MINIO_BASE_URL=http://localhost:9002 bun test --env-file=.env.local",
    "typecheck": "bunx tsc --noEmit -p apps/api/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/workers/*"
  ],
  "dependencies": {
    "zod": "^4.1.12"
  },
  "overrides": {
    "ioredis": "^5.9.1"
  }
}